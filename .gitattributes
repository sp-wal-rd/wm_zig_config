# Byte-stable across Windows and Linux publishers.
# Without eol=lf, core.autocrlf=true on a dev box turns every publish into a
# whole-file diff and breaks the publisher's idempotency check.
* text=auto eol=lf

*.json            text eol=lf
*.py              text eol=lf
*.md              text eol=lf
*.ps1             text eol=crlf
tools/githooks/** text eol=lf

# Generated by the publisher — collapse in PR diffs, but stay readable.
zigs/*.json          linguist-generated=true
zigs/released/*.json linguist-generated=true
index.json           linguist-generated=true

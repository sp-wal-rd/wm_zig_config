{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sp-wal-rd/wm_zig_config/main/schema/index.schema.json",
  "title": "Walnut Medical ZIG config index",
  "description": "Generated by tools/wm_zig_publish.py in the same commit as the zigs/*.json it summarises. Carries the full params so ZigInstaller can fetch ONE file and have every master. Deliberately has no generated_at field - a volatile field would defeat idempotency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "count",
    "zigs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "zigs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prefix",
          "customer_name",
          "file",
          "commit",
          "published_at",
          "params"
        ],
        "properties": {
          "prefix": {
            "type": "string"
          },
          "customer_name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "released_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "channel": {
            "enum": [
              "dev",
              "released"
            ]
          },
          "params": {
            "type": "object"
          },
          "extra": {
            "type": "object"
          },
          "publisher": {
            "type": "object"
          }
        }
      }
    }
  }
}

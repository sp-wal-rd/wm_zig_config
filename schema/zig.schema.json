{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sp-wal-rd/wm_zig_config/main/schema/zig.schema.json",
  "title": "Walnut Medical ZIG verification parameters",
  "description": "One published ZIG program spec. Generated by tools/wm_zig_publish.py from the ZIG repo's config.py plus its wm_zig.json. Never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "prefix",
    "customer_name",
    "repo",
    "branch",
    "commit",
    "published_at",
    "publisher",
    "params",
    "sources"
  ],
  "$defs": {
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/\u2013 -]{0,119}$",
      "description": "Shape whitelist calibrated on the real corpus. U+2013 EN DASH is permitted because PTM's BATCH_ID contains one. Excludes ':' and '?', so a URL cannot pass."
    },
    "value_or_blank": {
      "type": "string",
      "maxLength": 120
    }
  },
  "properties": {
    "schema": {
      "const": "https://raw.githubusercontent.com/sp-wal-rd/wm_zig_config/main/schema/zig.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,23}$",
      "description": "Device-side program prefix: repo directory name minus _TEST_ZIG[_FAST]. This is the join key with ZigInstaller's infer_prefix_scores()."
    },
    "customer_name": {
      "$ref": "#/$defs/value"
    },
    "repo": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\\.git$"
    },
    "branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,60}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit at which these params LAST CHANGED - not the repo's latest commit. The publisher is idempotent on content, so an unrelated push does not move this."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time of the last params change. Moves only when commit moves."
    },
    "channel": {
      "enum": [
        "dev",
        "released"
      ],
      "description": "dev = published from a branch push (R&D tip). released = published from an annotated tag push (approved build). ZigInstaller verifies against released by default."
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 120
        },
        "approved_on": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "eval_version",
        "eval_sha256"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "maxLength": 20
        },
        "eval_version": {
          "type": "integer",
          "minimum": 1
        },
        "eval_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the wm_zig_eval.py that produced these values. CI fails if it differs from tools/wm_zig_eval.py at HEAD - that is the evaluator-drift alarm."
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_jig_app",
        "customer_app",
        "test_jig_production_app",
        "sound_file_version",
        "sdk_version",
        "pcb_batch_id",
        "customer_name"
      ],
      "properties": {
        "test_jig_app": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        },
        "customer_app": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        },
        "test_jig_production_app": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        },
        "sound_file_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        },
        "sdk_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        },
        "pcb_batch_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        },
        "customer_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "const": ""
            }
          ]
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_jig_app",
        "customer_app",
        "test_jig_production_app",
        "sound_file_version",
        "sdk_version",
        "pcb_batch_id",
        "customer_name"
      ],
      "properties": {
        "test_jig_app": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        },
        "customer_app": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        },
        "test_jig_production_app": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        },
        "sound_file_version": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        },
        "sdk_version": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        },
        "pcb_batch_id": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        },
        "customer_name": {
          "enum": [
            "config.py",
            "declared",
            "unverifiable"
          ]
        }
      }
    },
    "extra": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "description": "Free-form additions declared in the ZIG repo's wm_zig.json. Never populated from config.py. unverifiable_keys is the one reserved key.",
      "properties": {
        "unverifiable_keys": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "enum": [
              "test_jig_app",
              "customer_app",
              "test_jig_production_app",
              "sound_file_version",
              "sdk_version",
              "pcb_batch_id",
              "customer_name"
            ]
          },
          "description": "Params declared here that this program's config.py cannot expose. ZigInstaller downgrades such a row to advisory ONLY if the device also returned nothing - so this can never mute a real mismatch."
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    }
  }
}
